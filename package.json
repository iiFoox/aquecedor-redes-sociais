{
  "name": "insta-warmer",
  "version": "1.2.0",
  "description": "WarmUp Studio: aquecimento de contas do TikTok e do Instagram, com painel web e Supabase",
  "private": true,
  "main": "start.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node start.js",
    "motor": "node motor/index.js",
    "painel": "node painel/index.js",
    "ligar": "node scripts/servico.js ligar",
    "desligar": "node scripts/servico.js desligar",
    "reiniciar": "node scripts/servico.js reiniciar",
    "status": "node scripts/servico.js status",
    "logs": "node scripts/servico.js logs",
    "autostart:ligar": "node scripts/servico.js autostart:ligar",
    "autostart:desligar": "node scripts/servico.js autostart:desligar",
    "restaurar": "node scripts/restaurar.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm test",
    "postinstall": "npx playwright install chromium"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "express": "^4.19.2",
    "ghost-cursor": "^1.4.2",
    "playwright": "^1.47.0",
    "playwright-extra": "^4.3.6",
    "pm2": "^7.0.4",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
