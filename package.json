{
  "name": "insta-warmer",
  "version": "2.1.10",
  "description": "WarmUp Studio: aquecimento de contas do TikTok e do Instagram, com painel web e Supabase",
  "private": true,
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node start.js",
    "motor": "node motor/index.js",
    "painel": "node painel/index.js",
    "build": "node scripts/build-web.js --force",
    "dev:web": "vite --config web/vite.config.mts",
    "app": "node scripts/app.js",
    "instalador": "node scripts/publicar.js --so-gerar",
    "publicar": "node scripts/publicar.js",
    "liberar": "node scripts/liberar.js",
    "icones": "node scripts/icones.js",
    "ligar": "node scripts/servico.js ligar",
    "desligar": "node scripts/servico.js desligar",
    "reiniciar": "node scripts/servico.js reiniciar",
    "status": "node scripts/servico.js status",
    "logs": "node scripts/servico.js logs",
    "autostart:ligar": "node scripts/servico.js autostart:ligar",
    "autostart:desligar": "node scripts/servico.js autostart:desligar",
    "restaurar": "node scripts/restaurar.js",
    "simular": "node scripts/simular.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test",
    "postinstall": "npx playwright install chromium",
    "typecheck": "tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "express": "^4.19.2",
    "ghost-cursor": "^1.4.2",
    "playwright": "^1.47.0",
    "playwright-extra": "^4.3.6",
    "pm2": "^7.0.4",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "productName": "WarmUp Studio",
  "author": "iiFoox",
  "build": {
    "appId": "com.warmupstudio.app",
    "productName": "WarmUp Studio",
    "copyright": "Uso pessoal",
    "directories": {
      "output": "release",
      "buildResources": "desktop/icons"
    },
    "asar": false,
    "afterPack": "scripts/manifesto.js",
    "files": [
      "package.json",
      "desktop/**/*",
      "motor/**/*",
      "painel/**/*",
      "web/dist/**/*",
      "!**/*.map",
      "!node_modules/pm2/**",
      "!node_modules/.cache/**",
      "!node_modules/@pm2/**"
    ],
    "extraMetadata": {
      "main": "desktop/main.js",
      "name": "warmup-studio",
      "wuAppId": "com.warmupstudio.app"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icons/app.ico",
      "executableName": "WarmUp Studio"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "WarmUp Studio",
      "uninstallDisplayName": "WarmUp Studio",
      "installerIcon": "desktop/icons/app.ico",
      "uninstallerIcon": "desktop/icons/app.ico",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "WarmUp-Studio-Setup-${version}.${ext}",
      "include": "desktop/installer.nsh"
    },
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ]
  }
}
