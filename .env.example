SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave SECRETA (Project Settings > API Keys > sb_secret_... ou service_role). Nunca a anon.
SUPABASE_KEY=sua-chave-secreta

# Opcional: senha do painel (o navegador pede usuário e senha; usuário pode ser qualquer um)
# PANEL_PASSWORD=
# Opcional: 0.0.0.0 abre o painel na rede local (padrão: só esta máquina)
# HOST=127.0.0.1
# Opcional: portas do painel (site) e do motor (robô, só nesta máquina)
# PORT=3001
# MOTOR_PORT=3101
# Opcional: fuso usado para virar o dia e para a janela de horário
# APP_TZ=America/Sao_Paulo
# Opcional: pasta do backup diário dos logins (padrão: OneDrive\Backups\WarmUp Studio)
# BACKUP_DIR=
